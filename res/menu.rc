#include "resource.h"
IDR_MENU MENU

BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Load Rom\tF1", ID_LOAD_ROM
        POPUP "Recent Roms"
        BEGIN
            MENUITEM "No Recent Files", ID_RECENT_PLACEHOLDER, GRAYED 
        END
        MENUITEM "Reload Rom\tF2", ID_RELOAD, GRAYED
    END
    POPUP "Options"
    BEGIN
        POPUP "Quirks"
        BEGIN
            MENUITEM "VF Reset", ID_VF_RESET 
            MENUITEM "Memory", ID_MEMORY
            MENUITEM "Display Wait", ID_DISPLAY_WAIT
            MENUITEM "Clipping", ID_CLIPPING
            MENUITEM "Shifting", ID_SHIFTING
            MENUITEM "Jumping", ID_JUMPING
        END
        MENUITEM "SuperChip Mode", ID_SUPERCHIP
    END
    POPUP "Speed"
    BEGIN
        MENUITEM "500", ID_500
        MENUITEM "600", ID_600
        MENUITEM "700", ID_700
        MENUITEM "800", ID_800
        MENUITEM "900", ID_900
        MENUITEM "1000", ID_1000
    END
    POPUP "Debug"
    BEGIN
        MENUITEM "View Debug\tF4" ID_DEBUG
        MENUITEM "Pause\tF5" ID_PAUSE
        MENUITEM "Step Instruction\tF6" ID_STEP 
    END
END
    
